local M = {}

local registry = require("mason-registry")

--- Query Mason registry for all packages relevant to a set of languages.
--- Detection matches packages whose spec.languages intersect `keywords`,
--- OR whose package name fuzzy-matches any keyword
--- (characters appear in order, case-insensitive, gaps allowed).
--- Returns packages grouped by their raw Mason category (e.g. "LSP", "Linter",
--- "Formatter"); the UI layer is responsible for mapping these to UI
--- categories. Each package entry carries an `installed` boolean so the UI
--- can mark already-installed packages instead of hiding them.
--- A single Mason package entry with install status.
---@class MasonPackage
---@field name string
---@field spec MasonPackageSpec
---@field installed boolean
---@field score? number fuzzy match score (higher = better match), math.huge for language matches

--- Mason package registry spec. Self-defined so mason-suggest stays
--- self-contained and does not depend on mason-core.internal module paths.
---@class MasonPackageSpec
---@field schema string
---@field name string
---@field system? boolean
---@field description string
---@field homepage string
---@field licenses string[]
---@field languages string[]
---@field categories string[]
---@field deprecation? {since: string, message: string}
---@field source {id: string, supported_platforms?: table[], version_overrides?: {constraint: string}[]}
---@field schemas? {lsp?: string}
---@field bin? table<string, string>
---@field share? table<string, string>
---@field opt? table<string, string>

-- Fuzzy match: characters of `pattern` must appear in order in `text`
-- (case-insensitive, gaps allowed). E.g. "golang" matches "golang-ls" and
-- "gopls" (g-o-l-a-n-g in order).
-- Returns a numeric score (higher = better match) or nil when no match.
-- Scoring:
--   +1 per matched character
--   +1 consecutive bonus when the matched char is adjacent to the previous
--     matched char in the text (rewards contiguous runs like "git" in "gitlint")
--   +3 prefix bonus when the match starts at position 1 of the text
---@param text string lowercased haystack
---@param pattern string lowercased needle
---@return integer|nil score or nil when no match
local function fuzzy_match(text, pattern)
  if pattern == "" or pattern == nil then
    return 0
  end
  local plen = #pattern
  local pi = 1
  local score = 0
  local prev_ti = 0
  local first_ti = 0
  for ti = 1, #text do
    if text:byte(ti) == pattern:byte(pi) then
      if first_ti == 0 then
        first_ti = ti
      end
      score = score + 1 -- base match
      if prev_ti ~= 0 and ti == prev_ti + 1 then
        score = score + 1 -- consecutive bonus
      end
      prev_ti = ti
      pi = pi + 1
      if pi > plen then
        if first_ti == 1 then
          score = score + 3 -- prefix bonus
        end
        return score
      end
    end
  end
  return nil
end

-- Shared implementation for tools_for_keywords / tools_for_category.
-- No registry cache is used (to avoid staling); every call performs a fresh scan
-- but with an optimized matching loop.
---@param keywords table<string, boolean> lowercased language ids or name substrings to match
---@param category? string "LSP" | "Linter" | "Formatter" | "DAP", or nil for all categories
---@param min_score? number only include entries with score >= this threshold (default 1)
---@return MasonPackagesByCategory
local function filter_registry_tools(keywords, category, min_score)
  min_score = min_score or 1
  local specs = registry.get_all_package_specs()
  local installed_names = registry.get_installed_package_names()

  -- Build O(1) installed lookup set.
  local installed_set = {}
  for _, name in ipairs(installed_names) do
    installed_set[name] = true
  end

  -- Flatten keyword set into a list so the fuzzy loop can use ipairs
  -- (faster than pairs over a set in the hot path). Keywords are already
  -- lowercased by the caller.
  local kw_list = {}
  for kw in pairs(keywords) do
    kw_list[#kw_list + 1] = kw
  end
  local kw_count = #kw_list

  local tools = {}

  for _, spec in ipairs(specs) do
    local name = spec.name
    local name_lower = name:lower()
    local best_score = nil

    -- 1. Language intersection: any spec.languages entry matches a keyword.
    --    Treat as a perfect score (highest priority).
    local langs = spec.languages
    if langs ~= nil then
      for _, lang in ipairs(langs) do
        if keywords[lang:lower()] ~= nil then
          best_score = math.huge
          break
        end
      end
    end

    -- 2. Name fuzzy: only when the package has no defined languages
    --    (spec.languages is nil or empty). If languages are defined but none
    --    matched the keywords, we skip name fuzzy entirely.
    if best_score == nil and kw_count > 0 and (not langs or #langs == 0) then
      for i = 1, kw_count do
        local s = fuzzy_match(name_lower, kw_list[i])
        if s ~= nil then
          if best_score == nil or s > best_score then
            best_score = s
          end
        end
      end
    end

    if best_score == nil or best_score < min_score then
      goto continue
    end

    local cats = spec.categories
    if cats ~= nil then
      -- When a category filter is active, first check the package belongs to it.
      local in_target = true
      if category then
        in_target = false
        for _, cat in ipairs(cats) do
          if cat == category then
            in_target = true
            break
          end
        end
      end

      if in_target then
        for _, cat in ipairs(cats) do
          if not category or cat == category then
            if tools[cat] == nil then
              tools[cat] = {}
            end
            tools[cat][#tools[cat] + 1] = {
              name = name,
              spec = spec,
              installed = installed_set[name] == true,
              score = best_score,
            }
          end
        end
      end
    end

    ::continue::
  end

  -- Sort each category's packages by score (best match first).
  for _, pkgs in pairs(tools) do
    table.sort(pkgs, function(a, b)
      if a.score ~= b.score then
        return a.score > b.score
      end
      return a.name < b.name
    end)
  end

  -- Remove empty categories
  local result = {}
  for cat, pkgs in pairs(tools) do
    if #pkgs > 0 then
      result[cat] = pkgs
    end
  end
  return result
end

--- Packages grouped by their raw Mason category (e.g. "LSP", "Linter",
--- "Formatter", "DAP").
---@alias MasonPackagesByCategory table<"LSP" | "Linter" | "Formatter" | "DAP", MasonPackage[]>
---@param keywords table<string, boolean> lowercased language ids or name substrings to match
---@param min_score? number only include entries with score >= this threshold (default 1)
---@return MasonPackagesByCategory
M.tools_for_keywords = function(keywords, min_score)
  return filter_registry_tools(keywords, nil, min_score)
end

--- Get tools matching keywords, restricted to a single Mason category.
--- Useful when you only want packages of one type (e.g. only "LSP") without
--- scanning/returning unrelated categories.
---@param keywords table<string, boolean> lowercased language ids or name substrings to match
---@param category string|nil "LSP" | "Linter" | "Formatter" | "DAP", or nil for all categories
---@param min_score? number only include entries with score >= this threshold (default 1)
---@return MasonPackagesByCategory
M.tools_for_category = function(keywords, category, min_score)
  return filter_registry_tools(keywords, category, min_score)
end


--- Check if a Mason package is installed.
---@param pkg_name string
---@return boolean
M.is_installed = function(pkg_name)
  if not pkg_name or pkg_name == "" then return false end
  return registry.is_installed(pkg_name)
end

--- Install a list of Mason packages.
--- Caller is expected to pre-filter already-installed packages.
---@param pkgs string[]
M.install_packages = function(pkgs)
  local logger = require("mason-suggest.logger")

  if not registry then
    logger.error("Cannot install packages: mason-registry unavailable.")
    return
  end

  for _, pkg_name in ipairs(pkgs) do
    -- Use has_package (safe, non-erroring) before get_package to avoid pcall.
    if not registry.has_package(pkg_name) then
      logger.warn(string.format("Package %s not found in Mason registry.", pkg_name))
    elseif registry.is_installed(pkg_name) then
      logger.info(string.format("%s is already installed.", pkg_name))
    else
      logger.info(string.format("Installing %s...", pkg_name))

      local package = registry.get_package(pkg_name)
      local job = package:install()
      if job then
        job:after(function()
          if registry.is_installed(pkg_name) then
            logger.info(string.format("%s installed successfully.", pkg_name))
          else
            logger.error(string.format("Failed to install %s.", pkg_name))
          end
        end)
      else
        logger.error(string.format("Installation job for %s could not be started.", pkg_name))
      end
    end
  end
end

return M
